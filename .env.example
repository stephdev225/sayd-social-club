# Copy to .env.local for local development. In Vercel: Project → Settings → Environment Variables.
# NEVER commit real values. None of these is exposed to the browser (no NEXT_PUBLIC_ prefix).

# Public URL of the site (used in Stripe return URLs and email links)
SITE_URL=http://localhost:3000

# --- Stripe (TEST MODE: keys start with sk_test_) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint page in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Live keys are refused unless this is set to "true" (production switch-over only)
STRIPE_ALLOW_LIVE=false

# --- Staff access ---
# /admin dashboard (everything) — at least 10 characters
ADMIN_PASSWORD=
# /scan door scanner only — at least 8 characters
STAFF_PASSWORD=

# --- Firebase Admin (service account: Firebase console → Project settings → Service accounts) ---
# Simplest: paste the whole downloaded JSON file into one variable
FIREBASE_SERVICE_ACCOUNT=
# …or the three separate values:
FIREBASE_PROJECT_ID=sayd-social-club
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@sayd-social-club.iam.gserviceaccount.com
# Keep the quotes and the \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Email (Brevo transactional). Without a key, emails are logged instead of sent. ---
BREVO_API_KEY=
EMAIL_FROM=billets@saydsocialclub.com
EMAIL_FROM_NAME=Sayd Social Club
TEAM_EMAIL=bonjour@saydsocialclub.com

# --- Local development only (ignored in production builds) ---
# Click through the whole purchase without Stripe: a fake "Stripe + webhook" runs the real fulfilment code.
DEMO_PAYMENTS=false
# Allow online sales with the in-memory store (orders lost on restart)
ALLOW_MEMORY_STORE=false
